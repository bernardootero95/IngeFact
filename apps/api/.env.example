# PostgreSQL (docker-compose: servicio "postgres", puerto 5433 en el host)
DATABASE_URL=postgresql+psycopg://ingefact:ingefact@localhost:5433/ingefact

# Alegra e-provider API
ALEGRA_ENV=sandbox
ALEGRA_BASE_URL=https://sandbox-api.alegra.com/e-provider/col/v1
ALEGRA_TOKEN=

# Clave maestra para encriptar credenciales Alegra guardadas en BD (Fernet key)
CREDENTIALS_ENCRYPTION_KEY=

LOG_LEVEL=INFO
