# PostgreSQL (docker-compose: servicio "postgres", puerto 5434 en el host --
# 5433 esta ocupado por un PostgreSQL nativo de Windows en esta maquina, y 5432
# por el stack local de Supabase)
DATABASE_URL=postgresql+psycopg://ingefact:ingefact@localhost:5434/ingefact

# "development" | "production" -- en production, el token de recuperacion de
# contrasena deja de escribirse en texto plano en los logs (no hay proveedor
# de email conectado todavia, ver docs de Sprint 1)
ENVIRONMENT=development

# Alegra e-provider API
ALEGRA_ENV=sandbox
ALEGRA_BASE_URL=https://sandbox-api.alegra.com/e-provider/col/v1
ALEGRA_TOKEN=

# Firma de los access tokens JWT (HS256) -- generar con secrets.token_urlsafe(64)
JWT_SECRET=

LOG_LEVEL=INFO

# Origins permitidos por CORS, como regex -- en production, fijar el(los)
# dominio(s) reales del frontend en vez del default de localhost. Ejemplo:
# CORS_ALLOW_ORIGIN_REGEX=https://(admin|app)\.ingefact\.com
CORS_ALLOW_ORIGIN_REGEX=http://localhost:\d+

# Resend (https://resend.com) -- correo transaccional (reset de contrasena,
# invitacion de usuario tenant, envio de factura al cliente, aviso de cuota).
RESEND_API_KEY=
EMAIL_FROM=IngeFact <notificaciones@ingefact.com>
# URLs de apps/user y apps/admin usadas para armar links dentro de los correos.
USER_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:5173
